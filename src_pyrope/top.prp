// Integrated translation of src/top.sv, controller.sv, and mac_cell.sv.
// Typed Pyrope syntax supported by the installed LiveHD lhd driver.
// Register reads observe Q; writes commit together on the rising clock edge.
pub mod top(clk:Clock, rst:U1, start:U1, a_in:[4]U32, b_in:[4]U32)
  -> (done:U1@[], y_out:[4][4]U64@[]) {
  reg state:U2:[clock_pin=clk] = nil
  reg count:U4:[clock_pin=clk] = nil
  reg a_delay_1_0:U32:[clock_pin=clk] = nil
  reg a_delay_2_0:U32:[clock_pin=clk] = nil
  reg a_delay_2_1:U32:[clock_pin=clk] = nil
  reg a_delay_3_0:U32:[clock_pin=clk] = nil
  reg a_delay_3_1:U32:[clock_pin=clk] = nil
  reg a_delay_3_2:U32:[clock_pin=clk] = nil
  reg b_delay_1_0:U32:[clock_pin=clk] = nil
  reg b_delay_2_0:U32:[clock_pin=clk] = nil
  reg b_delay_2_1:U32:[clock_pin=clk] = nil
  reg b_delay_3_0:U32:[clock_pin=clk] = nil
  reg b_delay_3_1:U32:[clock_pin=clk] = nil
  reg b_delay_3_2:U32:[clock_pin=clk] = nil
  reg x_0_0:U32:[clock_pin=clk] = nil
  reg w_0_0:U32:[clock_pin=clk] = nil
  reg y_0_0:U64:[clock_pin=clk] = nil
  reg x_0_1:U32:[clock_pin=clk] = nil
  reg w_0_1:U32:[clock_pin=clk] = nil
  reg y_0_1:U64:[clock_pin=clk] = nil
  reg x_0_2:U32:[clock_pin=clk] = nil
  reg w_0_2:U32:[clock_pin=clk] = nil
  reg y_0_2:U64:[clock_pin=clk] = nil
  reg x_0_3:U32:[clock_pin=clk] = nil
  reg w_0_3:U32:[clock_pin=clk] = nil
  reg y_0_3:U64:[clock_pin=clk] = nil
  reg x_1_0:U32:[clock_pin=clk] = nil
  reg w_1_0:U32:[clock_pin=clk] = nil
  reg y_1_0:U64:[clock_pin=clk] = nil
  reg x_1_1:U32:[clock_pin=clk] = nil
  reg w_1_1:U32:[clock_pin=clk] = nil
  reg y_1_1:U64:[clock_pin=clk] = nil
  reg x_1_2:U32:[clock_pin=clk] = nil
  reg w_1_2:U32:[clock_pin=clk] = nil
  reg y_1_2:U64:[clock_pin=clk] = nil
  reg x_1_3:U32:[clock_pin=clk] = nil
  reg w_1_3:U32:[clock_pin=clk] = nil
  reg y_1_3:U64:[clock_pin=clk] = nil
  reg x_2_0:U32:[clock_pin=clk] = nil
  reg w_2_0:U32:[clock_pin=clk] = nil
  reg y_2_0:U64:[clock_pin=clk] = nil
  reg x_2_1:U32:[clock_pin=clk] = nil
  reg w_2_1:U32:[clock_pin=clk] = nil
  reg y_2_1:U64:[clock_pin=clk] = nil
  reg x_2_2:U32:[clock_pin=clk] = nil
  reg w_2_2:U32:[clock_pin=clk] = nil
  reg y_2_2:U64:[clock_pin=clk] = nil
  reg x_2_3:U32:[clock_pin=clk] = nil
  reg w_2_3:U32:[clock_pin=clk] = nil
  reg y_2_3:U64:[clock_pin=clk] = nil
  reg x_3_0:U32:[clock_pin=clk] = nil
  reg w_3_0:U32:[clock_pin=clk] = nil
  reg y_3_0:U64:[clock_pin=clk] = nil
  reg x_3_1:U32:[clock_pin=clk] = nil
  reg w_3_1:U32:[clock_pin=clk] = nil
  reg y_3_1:U64:[clock_pin=clk] = nil
  reg x_3_2:U32:[clock_pin=clk] = nil
  reg w_3_2:U32:[clock_pin=clk] = nil
  reg y_3_2:U64:[clock_pin=clk] = nil
  reg x_3_3:U32:[clock_pin=clk] = nil
  reg w_3_3:U32:[clock_pin=clk] = nil
  reg y_3_3:U64:[clock_pin=clk] = nil

  // Current-state decode. IDLE=0, COMPUTE=1, DONE=2.
  const mac_en = (state == 1)
  const count_done = (count == 9)
  done = U1(state == 2)

  // Synchronous reset and controller transitions.
  if rst != 0 {
    state = 0
    count = 0
  }else{
    if state == 0 {
      if start != 0 { state = 1 }else{ state = 0 }
    }elif state == 1 {
      if count_done { state = 2 }else{ state = 1 }
    }else{
      state = 0
    }
    if mac_en {
      if not count_done { count = (count + 1) & 15 }
    }else{
      count = 0
    }
  }

  // Skew pipelines run on every clock, including reset and idle.
  // Like the original RTL, they have no reset. Flush with zeros for 3 clocks.
  a_delay_1_0 = a_in[1]
  a_delay_2_0 = a_in[2]
  a_delay_2_1 = a_delay_2_0
  a_delay_3_0 = a_in[3]
  a_delay_3_1 = a_delay_3_0
  a_delay_3_2 = a_delay_3_1
  b_delay_1_0 = b_in[1]
  b_delay_2_0 = b_in[2]
  b_delay_2_1 = b_delay_2_0
  b_delay_3_0 = b_in[3]
  b_delay_3_1 = b_delay_3_0
  b_delay_3_2 = b_delay_3_1

  // MAC cell (0, 0): operand forwarding and stationary accumulator.
  if rst != 0 {
    x_0_0 = 0
    w_0_0 = 0
    y_0_0 = 0
  }elif mac_en {
    x_0_0 = a_in[0]
    w_0_0 = b_in[0]
    y_0_0 = (y_0_0 + (a_in[0] * b_in[0])) & 0xffffffffffffffff
  }
  y_out[0][0] = y_0_0

  // MAC cell (0, 1): operand forwarding and stationary accumulator.
  if rst != 0 {
    x_0_1 = 0
    w_0_1 = 0
    y_0_1 = 0
  }elif mac_en {
    x_0_1 = x_0_0
    w_0_1 = b_delay_1_0
    y_0_1 = (y_0_1 + (x_0_0 * b_delay_1_0)) & 0xffffffffffffffff
  }
  y_out[0][1] = y_0_1

  // MAC cell (0, 2): operand forwarding and stationary accumulator.
  if rst != 0 {
    x_0_2 = 0
    w_0_2 = 0
    y_0_2 = 0
  }elif mac_en {
    x_0_2 = x_0_1
    w_0_2 = b_delay_2_1
    y_0_2 = (y_0_2 + (x_0_1 * b_delay_2_1)) & 0xffffffffffffffff
  }
  y_out[0][2] = y_0_2

  // MAC cell (0, 3): operand forwarding and stationary accumulator.
  if rst != 0 {
    x_0_3 = 0
    w_0_3 = 0
    y_0_3 = 0
  }elif mac_en {
    x_0_3 = x_0_2
    w_0_3 = b_delay_3_2
    y_0_3 = (y_0_3 + (x_0_2 * b_delay_3_2)) & 0xffffffffffffffff
  }
  y_out[0][3] = y_0_3

  // MAC cell (1, 0): operand forwarding and stationary accumulator.
  if rst != 0 {
    x_1_0 = 0
    w_1_0 = 0
    y_1_0 = 0
  }elif mac_en {
    x_1_0 = a_delay_1_0
    w_1_0 = w_0_0
    y_1_0 = (y_1_0 + (a_delay_1_0 * w_0_0)) & 0xffffffffffffffff
  }
  y_out[1][0] = y_1_0

  // MAC cell (1, 1): operand forwarding and stationary accumulator.
  if rst != 0 {
    x_1_1 = 0
    w_1_1 = 0
    y_1_1 = 0
  }elif mac_en {
    x_1_1 = x_1_0
    w_1_1 = w_0_1
    y_1_1 = (y_1_1 + (x_1_0 * w_0_1)) & 0xffffffffffffffff
  }
  y_out[1][1] = y_1_1

  // MAC cell (1, 2): operand forwarding and stationary accumulator.
  if rst != 0 {
    x_1_2 = 0
    w_1_2 = 0
    y_1_2 = 0
  }elif mac_en {
    x_1_2 = x_1_1
    w_1_2 = w_0_2
    y_1_2 = (y_1_2 + (x_1_1 * w_0_2)) & 0xffffffffffffffff
  }
  y_out[1][2] = y_1_2

  // MAC cell (1, 3): operand forwarding and stationary accumulator.
  if rst != 0 {
    x_1_3 = 0
    w_1_3 = 0
    y_1_3 = 0
  }elif mac_en {
    x_1_3 = x_1_2
    w_1_3 = w_0_3
    y_1_3 = (y_1_3 + (x_1_2 * w_0_3)) & 0xffffffffffffffff
  }
  y_out[1][3] = y_1_3

  // MAC cell (2, 0): operand forwarding and stationary accumulator.
  if rst != 0 {
    x_2_0 = 0
    w_2_0 = 0
    y_2_0 = 0
  }elif mac_en {
    x_2_0 = a_delay_2_1
    w_2_0 = w_1_0
    y_2_0 = (y_2_0 + (a_delay_2_1 * w_1_0)) & 0xffffffffffffffff
  }
  y_out[2][0] = y_2_0

  // MAC cell (2, 1): operand forwarding and stationary accumulator.
  if rst != 0 {
    x_2_1 = 0
    w_2_1 = 0
    y_2_1 = 0
  }elif mac_en {
    x_2_1 = x_2_0
    w_2_1 = w_1_1
    y_2_1 = (y_2_1 + (x_2_0 * w_1_1)) & 0xffffffffffffffff
  }
  y_out[2][1] = y_2_1

  // MAC cell (2, 2): operand forwarding and stationary accumulator.
  if rst != 0 {
    x_2_2 = 0
    w_2_2 = 0
    y_2_2 = 0
  }elif mac_en {
    x_2_2 = x_2_1
    w_2_2 = w_1_2
    y_2_2 = (y_2_2 + (x_2_1 * w_1_2)) & 0xffffffffffffffff
  }
  y_out[2][2] = y_2_2

  // MAC cell (2, 3): operand forwarding and stationary accumulator.
  if rst != 0 {
    x_2_3 = 0
    w_2_3 = 0
    y_2_3 = 0
  }elif mac_en {
    x_2_3 = x_2_2
    w_2_3 = w_1_3
    y_2_3 = (y_2_3 + (x_2_2 * w_1_3)) & 0xffffffffffffffff
  }
  y_out[2][3] = y_2_3

  // MAC cell (3, 0): operand forwarding and stationary accumulator.
  if rst != 0 {
    x_3_0 = 0
    w_3_0 = 0
    y_3_0 = 0
  }elif mac_en {
    x_3_0 = a_delay_3_2
    w_3_0 = w_2_0
    y_3_0 = (y_3_0 + (a_delay_3_2 * w_2_0)) & 0xffffffffffffffff
  }
  y_out[3][0] = y_3_0

  // MAC cell (3, 1): operand forwarding and stationary accumulator.
  if rst != 0 {
    x_3_1 = 0
    w_3_1 = 0
    y_3_1 = 0
  }elif mac_en {
    x_3_1 = x_3_0
    w_3_1 = w_2_1
    y_3_1 = (y_3_1 + (x_3_0 * w_2_1)) & 0xffffffffffffffff
  }
  y_out[3][1] = y_3_1

  // MAC cell (3, 2): operand forwarding and stationary accumulator.
  if rst != 0 {
    x_3_2 = 0
    w_3_2 = 0
    y_3_2 = 0
  }elif mac_en {
    x_3_2 = x_3_1
    w_3_2 = w_2_2
    y_3_2 = (y_3_2 + (x_3_1 * w_2_2)) & 0xffffffffffffffff
  }
  y_out[3][2] = y_3_2

  // MAC cell (3, 3): operand forwarding and stationary accumulator.
  if rst != 0 {
    x_3_3 = 0
    w_3_3 = 0
    y_3_3 = 0
  }elif mac_en {
    x_3_3 = x_3_2
    w_3_3 = w_2_3
    y_3_3 = (y_3_3 + (x_3_2 * w_2_3)) & 0xffffffffffffffff
  }
  y_out[3][3] = y_3_3
}
