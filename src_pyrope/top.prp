// Pyrope translation of src/top.sv, controller.sv, and mac_cell.sv.
// Uses the $input / %output / #register notation of the linked UCSC slides.
// Integrated datapath: every cell has distinct scalar registers.
// Register reads use __q_pin explicitly to retain pre-edge SV NBA semantics.
// Not yet compiled with LiveHD/Pyrope; see README.md.

$clk.__ubits = 1
$rst.__ubits = 1
$start.__ubits = 1
%done.__ubits = 1
$a_in[0].__ubits = 32
$a_in[1].__ubits = 32
$a_in[2].__ubits = 32
$a_in[3].__ubits = 32
$b_in[0].__ubits = 32
$b_in[1].__ubits = 32
$b_in[2].__ubits = 32
$b_in[3].__ubits = 32

// Explicit unsigned widths and a common rising-edge clock.
#state.__ubits = 2
#state.__clk_pin = $clk
#count.__ubits = 4
#count.__clk_pin = $clk
#a_delay_1_0.__ubits = 32
#a_delay_1_0.__clk_pin = $clk
#a_delay_2_0.__ubits = 32
#a_delay_2_0.__clk_pin = $clk
#a_delay_2_1.__ubits = 32
#a_delay_2_1.__clk_pin = $clk
#a_delay_3_0.__ubits = 32
#a_delay_3_0.__clk_pin = $clk
#a_delay_3_1.__ubits = 32
#a_delay_3_1.__clk_pin = $clk
#a_delay_3_2.__ubits = 32
#a_delay_3_2.__clk_pin = $clk
#b_delay_1_0.__ubits = 32
#b_delay_1_0.__clk_pin = $clk
#b_delay_2_0.__ubits = 32
#b_delay_2_0.__clk_pin = $clk
#b_delay_2_1.__ubits = 32
#b_delay_2_1.__clk_pin = $clk
#b_delay_3_0.__ubits = 32
#b_delay_3_0.__clk_pin = $clk
#b_delay_3_1.__ubits = 32
#b_delay_3_1.__clk_pin = $clk
#b_delay_3_2.__ubits = 32
#b_delay_3_2.__clk_pin = $clk
#x_0_0.__ubits = 32
#x_0_0.__clk_pin = $clk
#w_0_0.__ubits = 32
#w_0_0.__clk_pin = $clk
#y_0_0.__ubits = 64
#y_0_0.__clk_pin = $clk
#x_0_1.__ubits = 32
#x_0_1.__clk_pin = $clk
#w_0_1.__ubits = 32
#w_0_1.__clk_pin = $clk
#y_0_1.__ubits = 64
#y_0_1.__clk_pin = $clk
#x_0_2.__ubits = 32
#x_0_2.__clk_pin = $clk
#w_0_2.__ubits = 32
#w_0_2.__clk_pin = $clk
#y_0_2.__ubits = 64
#y_0_2.__clk_pin = $clk
#x_0_3.__ubits = 32
#x_0_3.__clk_pin = $clk
#w_0_3.__ubits = 32
#w_0_3.__clk_pin = $clk
#y_0_3.__ubits = 64
#y_0_3.__clk_pin = $clk
#x_1_0.__ubits = 32
#x_1_0.__clk_pin = $clk
#w_1_0.__ubits = 32
#w_1_0.__clk_pin = $clk
#y_1_0.__ubits = 64
#y_1_0.__clk_pin = $clk
#x_1_1.__ubits = 32
#x_1_1.__clk_pin = $clk
#w_1_1.__ubits = 32
#w_1_1.__clk_pin = $clk
#y_1_1.__ubits = 64
#y_1_1.__clk_pin = $clk
#x_1_2.__ubits = 32
#x_1_2.__clk_pin = $clk
#w_1_2.__ubits = 32
#w_1_2.__clk_pin = $clk
#y_1_2.__ubits = 64
#y_1_2.__clk_pin = $clk
#x_1_3.__ubits = 32
#x_1_3.__clk_pin = $clk
#w_1_3.__ubits = 32
#w_1_3.__clk_pin = $clk
#y_1_3.__ubits = 64
#y_1_3.__clk_pin = $clk
#x_2_0.__ubits = 32
#x_2_0.__clk_pin = $clk
#w_2_0.__ubits = 32
#w_2_0.__clk_pin = $clk
#y_2_0.__ubits = 64
#y_2_0.__clk_pin = $clk
#x_2_1.__ubits = 32
#x_2_1.__clk_pin = $clk
#w_2_1.__ubits = 32
#w_2_1.__clk_pin = $clk
#y_2_1.__ubits = 64
#y_2_1.__clk_pin = $clk
#x_2_2.__ubits = 32
#x_2_2.__clk_pin = $clk
#w_2_2.__ubits = 32
#w_2_2.__clk_pin = $clk
#y_2_2.__ubits = 64
#y_2_2.__clk_pin = $clk
#x_2_3.__ubits = 32
#x_2_3.__clk_pin = $clk
#w_2_3.__ubits = 32
#w_2_3.__clk_pin = $clk
#y_2_3.__ubits = 64
#y_2_3.__clk_pin = $clk
#x_3_0.__ubits = 32
#x_3_0.__clk_pin = $clk
#w_3_0.__ubits = 32
#w_3_0.__clk_pin = $clk
#y_3_0.__ubits = 64
#y_3_0.__clk_pin = $clk
#x_3_1.__ubits = 32
#x_3_1.__clk_pin = $clk
#w_3_1.__ubits = 32
#w_3_1.__clk_pin = $clk
#y_3_1.__ubits = 64
#y_3_1.__clk_pin = $clk
#x_3_2.__ubits = 32
#x_3_2.__clk_pin = $clk
#w_3_2.__ubits = 32
#w_3_2.__clk_pin = $clk
#y_3_2.__ubits = 64
#y_3_2.__clk_pin = $clk
#x_3_3.__ubits = 32
#x_3_3.__clk_pin = $clk
#w_3_3.__ubits = 32
#w_3_3.__clk_pin = $clk
#y_3_3.__ubits = 64
#y_3_3.__clk_pin = $clk

// Current-state decode. IDLE=0, COMPUTE=1, DONE=2.
mac_en = (#state.__q_pin == 1)
count_done = (#count.__q_pin == 9)
%done = (#state.__q_pin == 2)

// Synchronous reset and controller transitions.
if $rst {
  #state = 0
  #count = 0
}else{
  if #state.__q_pin == 0 {
    if $start { #state = 1 }else{ #state = 0 }
  }elif #state.__q_pin == 1 {
    if count_done { #state = 2 }else{ #state = 1 }
  }else{
    #state = 0
  }
  if mac_en {
    if !count_done { #count := #count.__q_pin + 1 }
  }else{
    #count = 0
  }
}

// Skew pipelines run on every clock, including reset and idle.
// Like the original RTL, they have no reset. Flush with zeros for 3 clocks.
#a_delay_1_0 = $a_in[1]
#a_delay_2_0 = $a_in[2]
#a_delay_2_1 = #a_delay_2_0.__q_pin
#a_delay_3_0 = $a_in[3]
#a_delay_3_1 = #a_delay_3_0.__q_pin
#a_delay_3_2 = #a_delay_3_1.__q_pin
#b_delay_1_0 = $b_in[1]
#b_delay_2_0 = $b_in[2]
#b_delay_2_1 = #b_delay_2_0.__q_pin
#b_delay_3_0 = $b_in[3]
#b_delay_3_1 = #b_delay_3_0.__q_pin
#b_delay_3_2 = #b_delay_3_1.__q_pin

// MAC cell (0, 0): operand forwarding and stationary accumulator.
if $rst {
  #x_0_0 = 0
  #w_0_0 = 0
  #y_0_0 = 0
}elif mac_en {
  #x_0_0 = $a_in[0]
  #w_0_0 = $b_in[0]
  #y_0_0 := #y_0_0.__q_pin + ($a_in[0] * $b_in[0])
}
%y_out[0][0].__ubits = 64
%y_out[0][0] = #y_0_0.__q_pin

// MAC cell (0, 1): operand forwarding and stationary accumulator.
if $rst {
  #x_0_1 = 0
  #w_0_1 = 0
  #y_0_1 = 0
}elif mac_en {
  #x_0_1 = #x_0_0.__q_pin
  #w_0_1 = #b_delay_1_0.__q_pin
  #y_0_1 := #y_0_1.__q_pin + (#x_0_0.__q_pin * #b_delay_1_0.__q_pin)
}
%y_out[0][1].__ubits = 64
%y_out[0][1] = #y_0_1.__q_pin

// MAC cell (0, 2): operand forwarding and stationary accumulator.
if $rst {
  #x_0_2 = 0
  #w_0_2 = 0
  #y_0_2 = 0
}elif mac_en {
  #x_0_2 = #x_0_1.__q_pin
  #w_0_2 = #b_delay_2_1.__q_pin
  #y_0_2 := #y_0_2.__q_pin + (#x_0_1.__q_pin * #b_delay_2_1.__q_pin)
}
%y_out[0][2].__ubits = 64
%y_out[0][2] = #y_0_2.__q_pin

// MAC cell (0, 3): operand forwarding and stationary accumulator.
if $rst {
  #x_0_3 = 0
  #w_0_3 = 0
  #y_0_3 = 0
}elif mac_en {
  #x_0_3 = #x_0_2.__q_pin
  #w_0_3 = #b_delay_3_2.__q_pin
  #y_0_3 := #y_0_3.__q_pin + (#x_0_2.__q_pin * #b_delay_3_2.__q_pin)
}
%y_out[0][3].__ubits = 64
%y_out[0][3] = #y_0_3.__q_pin

// MAC cell (1, 0): operand forwarding and stationary accumulator.
if $rst {
  #x_1_0 = 0
  #w_1_0 = 0
  #y_1_0 = 0
}elif mac_en {
  #x_1_0 = #a_delay_1_0.__q_pin
  #w_1_0 = #w_0_0.__q_pin
  #y_1_0 := #y_1_0.__q_pin + (#a_delay_1_0.__q_pin * #w_0_0.__q_pin)
}
%y_out[1][0].__ubits = 64
%y_out[1][0] = #y_1_0.__q_pin

// MAC cell (1, 1): operand forwarding and stationary accumulator.
if $rst {
  #x_1_1 = 0
  #w_1_1 = 0
  #y_1_1 = 0
}elif mac_en {
  #x_1_1 = #x_1_0.__q_pin
  #w_1_1 = #w_0_1.__q_pin
  #y_1_1 := #y_1_1.__q_pin + (#x_1_0.__q_pin * #w_0_1.__q_pin)
}
%y_out[1][1].__ubits = 64
%y_out[1][1] = #y_1_1.__q_pin

// MAC cell (1, 2): operand forwarding and stationary accumulator.
if $rst {
  #x_1_2 = 0
  #w_1_2 = 0
  #y_1_2 = 0
}elif mac_en {
  #x_1_2 = #x_1_1.__q_pin
  #w_1_2 = #w_0_2.__q_pin
  #y_1_2 := #y_1_2.__q_pin + (#x_1_1.__q_pin * #w_0_2.__q_pin)
}
%y_out[1][2].__ubits = 64
%y_out[1][2] = #y_1_2.__q_pin

// MAC cell (1, 3): operand forwarding and stationary accumulator.
if $rst {
  #x_1_3 = 0
  #w_1_3 = 0
  #y_1_3 = 0
}elif mac_en {
  #x_1_3 = #x_1_2.__q_pin
  #w_1_3 = #w_0_3.__q_pin
  #y_1_3 := #y_1_3.__q_pin + (#x_1_2.__q_pin * #w_0_3.__q_pin)
}
%y_out[1][3].__ubits = 64
%y_out[1][3] = #y_1_3.__q_pin

// MAC cell (2, 0): operand forwarding and stationary accumulator.
if $rst {
  #x_2_0 = 0
  #w_2_0 = 0
  #y_2_0 = 0
}elif mac_en {
  #x_2_0 = #a_delay_2_1.__q_pin
  #w_2_0 = #w_1_0.__q_pin
  #y_2_0 := #y_2_0.__q_pin + (#a_delay_2_1.__q_pin * #w_1_0.__q_pin)
}
%y_out[2][0].__ubits = 64
%y_out[2][0] = #y_2_0.__q_pin

// MAC cell (2, 1): operand forwarding and stationary accumulator.
if $rst {
  #x_2_1 = 0
  #w_2_1 = 0
  #y_2_1 = 0
}elif mac_en {
  #x_2_1 = #x_2_0.__q_pin
  #w_2_1 = #w_1_1.__q_pin
  #y_2_1 := #y_2_1.__q_pin + (#x_2_0.__q_pin * #w_1_1.__q_pin)
}
%y_out[2][1].__ubits = 64
%y_out[2][1] = #y_2_1.__q_pin

// MAC cell (2, 2): operand forwarding and stationary accumulator.
if $rst {
  #x_2_2 = 0
  #w_2_2 = 0
  #y_2_2 = 0
}elif mac_en {
  #x_2_2 = #x_2_1.__q_pin
  #w_2_2 = #w_1_2.__q_pin
  #y_2_2 := #y_2_2.__q_pin + (#x_2_1.__q_pin * #w_1_2.__q_pin)
}
%y_out[2][2].__ubits = 64
%y_out[2][2] = #y_2_2.__q_pin

// MAC cell (2, 3): operand forwarding and stationary accumulator.
if $rst {
  #x_2_3 = 0
  #w_2_3 = 0
  #y_2_3 = 0
}elif mac_en {
  #x_2_3 = #x_2_2.__q_pin
  #w_2_3 = #w_1_3.__q_pin
  #y_2_3 := #y_2_3.__q_pin + (#x_2_2.__q_pin * #w_1_3.__q_pin)
}
%y_out[2][3].__ubits = 64
%y_out[2][3] = #y_2_3.__q_pin

// MAC cell (3, 0): operand forwarding and stationary accumulator.
if $rst {
  #x_3_0 = 0
  #w_3_0 = 0
  #y_3_0 = 0
}elif mac_en {
  #x_3_0 = #a_delay_3_2.__q_pin
  #w_3_0 = #w_2_0.__q_pin
  #y_3_0 := #y_3_0.__q_pin + (#a_delay_3_2.__q_pin * #w_2_0.__q_pin)
}
%y_out[3][0].__ubits = 64
%y_out[3][0] = #y_3_0.__q_pin

// MAC cell (3, 1): operand forwarding and stationary accumulator.
if $rst {
  #x_3_1 = 0
  #w_3_1 = 0
  #y_3_1 = 0
}elif mac_en {
  #x_3_1 = #x_3_0.__q_pin
  #w_3_1 = #w_2_1.__q_pin
  #y_3_1 := #y_3_1.__q_pin + (#x_3_0.__q_pin * #w_2_1.__q_pin)
}
%y_out[3][1].__ubits = 64
%y_out[3][1] = #y_3_1.__q_pin

// MAC cell (3, 2): operand forwarding and stationary accumulator.
if $rst {
  #x_3_2 = 0
  #w_3_2 = 0
  #y_3_2 = 0
}elif mac_en {
  #x_3_2 = #x_3_1.__q_pin
  #w_3_2 = #w_2_2.__q_pin
  #y_3_2 := #y_3_2.__q_pin + (#x_3_1.__q_pin * #w_2_2.__q_pin)
}
%y_out[3][2].__ubits = 64
%y_out[3][2] = #y_3_2.__q_pin

// MAC cell (3, 3): operand forwarding and stationary accumulator.
if $rst {
  #x_3_3 = 0
  #w_3_3 = 0
  #y_3_3 = 0
}elif mac_en {
  #x_3_3 = #x_3_2.__q_pin
  #w_3_3 = #w_2_3.__q_pin
  #y_3_3 := #y_3_3.__q_pin + (#x_3_2.__q_pin * #w_2_3.__q_pin)
}
%y_out[3][3].__ubits = 64
%y_out[3][3] = #y_3_3.__q_pin
