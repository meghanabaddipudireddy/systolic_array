// Direct SRAM wiring; all memory controls are driven by the testbench.
pub mod sram_top(clk:Clock, rst:U1, start:U1,
  a_csb:U1, a_web:U1, a_addr:U4, a_din:U128,
  b_csb:U1, b_web:U1, b_addr:U4, b_din:U128)
  -> (done:U1@[], y_out:[4][4]U64@[], a_dout:U128@[], b_dout:U128@[]) {
  const sram = import("lg:sram_128x16")
  const array_core = import("lg:top.top")
  const activations = sram(clk0=clk, csb0=a_csb, web0=a_web, addr0=a_addr, din0=a_din)
  const weights = sram(clk0=clk, csb0=b_csb, web0=b_web, addr0=b_addr, din0=b_din)
  a_dout = activations.dout0
  b_dout = weights.dout0
  // Imported LGraph array ports are packed: lane i occupies bits 32*i +: 32.
  const array = array_core(clk=clk, rst=rst, start=start, a_in=a_dout, b_in=b_dout)
  done = array.done
  y_out = array.y_out
}
